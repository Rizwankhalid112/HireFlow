# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx

# PostgreSQL (auto-created by Docker Compose)
POSTGRES_DB=hireflow_db
POSTGRES_USER=hireflow_user
POSTGRES_PASSWORD=hireflow_pass
DB_NAME=hireflow_db
DB_USER=hireflow_user
DB_PASSWORD=hireflow_pass
DB_HOST=db
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Frontend
FRONTEND_URL=http://localhost:5173
# Leave blank: the client falls back to a relative /api, which is correct
# wherever the API is same-origin. Only set this for a split-domain setup.
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173

# Email
#
# The default prints mail to the console and sends nothing. That is fine
# locally. In a deployment it means no one can finish registering, and every
# verification link ends up in the server log in clear text.
#
# For a real deploy, set the backend to SMTP and fill in the four values below.
#   Gmail  host smtp.gmail.com       user <you>@gmail.com   pass = app password
#          (needs 2-Step Verification on, then Security -> App passwords)
#   Brevo  host smtp-relay.brevo.com user <brevo login>     pass = SMTP key
#   Resend host smtp.resend.com      user resend            pass = API key
#          (its test domain only delivers to your own address; real
#           recipients need a verified domain)
#
# EMAIL_HOST_PASSWORD is a credential: platform environment only, never here.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@hireflow.com

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI writing suggestions (cv_builder). Leave blank to disable the feature —
# the endpoints then return 503 and the rest of the app is unaffected.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_EFFORT=low
AI_MONTHLY_CREDITS=60
AI_SUGGEST_THROTTLE=20/min

# CV upload & AI parse (Steps 7-8)
CV_UPLOAD_THROTTLE=5/hour
AI_PARSE_MONTHLY_LIMIT=5
AI_PARSE_MAX_TOKENS=8000
JOB_MATCH_THROTTLE=10/hour
AI_JOB_MATCH_MONTHLY_LIMIT=20
AI_JOB_MATCH_MAX_TOKENS=6000
