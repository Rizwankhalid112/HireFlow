# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx

# PostgreSQL (auto-created by Docker Compose)
POSTGRES_DB=hireflow_db
POSTGRES_USER=hireflow_user
POSTGRES_PASSWORD=hireflow_pass
DB_NAME=hireflow_db
DB_USER=hireflow_user
DB_PASSWORD=hireflow_pass
DB_HOST=db
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Frontend
VITE_API_URL=http://localhost/api
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173

# Email (configure later)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
