    {
      "name": "4 - Skills",
      "item": [
        {
          "name": "Search Skills (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 && pm.response.json().length > 0) {",
                  "    pm.collectionVariables.set('canonical_id', pm.response.json()[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/cv/skills/search/?q=python",
              "host": ["{{base_url}}"],
              "path": ["cv", "skills", "search", ""],
              "query": [{ "key": "q", "value": "python" }]
            }
          }
        },
        {
          "name": "Add Skill via Canonical (POST)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if ([200, 201].includes(pm.response.code)) {",
                  "    pm.collectionVariables.set('skill_id', pm.response.json().id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canonical_id\": \"{{canonical_id}}\",\n  \"proficiency\": \"advanced\"\n}"
            },
            "url": "{{base_url}}/cv/skills/"
          }
        },
        {
          "name": "Add Freetext Skill (POST)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
