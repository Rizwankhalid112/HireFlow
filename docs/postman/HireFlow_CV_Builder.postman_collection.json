          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company_name\": \"Inovaqo\",\n  \"role_title\": \"Full Stack Developer\",\n  \"employment_type\": \"full_time\",\n  \"location\": \"Lahore, Pakistan\",\n  \"location_type\": \"hybrid\",\n  \"start_month\": 1,\n  \"start_year\": 2023,\n  \"is_current\": true,\n  \"order\": 0\n}"
            },
            "url": "{{base_url}}/cv/work-experience/"
          }
        },
        {
          "name": "List Experiences (GET)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/cv/work-experience/"
          }
        },
