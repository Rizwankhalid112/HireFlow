            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Wrote 180+ automated tests increasing coverage from 54% to 93%\",\n  \"order\": 1\n}"
            },
            "url": "{{base_url}}/cv/work-experience/{{experience_id}}/bullets/{{bullet_id}}/"
          }
        },
        {
          "name": "Reorder Bullets (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ordered_ids\": [\"{{bullet_id}}\"]\n}"
            },
            "url": "{{base_url}}/cv/work-experience/{{experience_id}}/bullets/reorder/"
          }
        },
        {
          "name": "Reorder Experiences (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
