{
  "info": {
    "name": "HireFlow - CV Builder API",
    "description": "Test all CV Builder endpoints (Steps 2-6).\n\nSetup:\n1. Set collection variables: base_url, email, password\n2. Run Auth > Login (saves access_token automatically)\n3. Run folders in order: Profile → Work Experience → Education → Skills → Projects → Certifications → Languages\n\nBase URL: http://localhost/api (via nginx) or http://localhost:8000/api (direct backend)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost/api" },
    { "key": "email", "value": "test@example.com" },
    { "key": "password", "value": "testpass123" },
    { "key": "access_token", "value": "" },
    { "key": "experience_id", "value": "" },
    { "key": "bullet_id", "value": "" },
    { "key": "education_id", "value": "" },
    { "key": "skill_id", "value": "" },
    { "key": "canonical_id", "value": "" },
    { "key": "project_id", "value": "" },
    { "key": "certification_id", "value": "" },
    { "key": "language_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "0 - Auth (run first)",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('access_token', pm.response.json().access);",
                  "    pm.test('Login OK', () => pm.response.to.have.status(200));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{base_url}}/auth/login/"
          }
        }
      ]
    },
    {
      "name": "1 - Profile",
      "item": [
        {
          "name": "Create Profile (POST)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/cv/profile/"
          }
        },
        {
          "name": "Get Profile (GET)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/cv/profile/"
          }
        },
        {
          "name": "Update Profile (PUT)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Muhammad Rizwan\",\n  \"professional_title\": \"Full Stack Developer\",\n  \"email\": \"rizwan@example.com\",\n  \"phone\": \"+923001234567\",\n  \"city\": \"Lahore\",\n  \"country\": \"Pakistan\",\n  \"linkedin_url\": \"linkedin.com/in/rizwan\",\n  \"github_url\": \"github.com/rizwan\",\n  \"portfolio_url\": \"https://rizwan.dev\",\n  \"summary\": \"Full stack developer with 3+ years building scalable web apps using Django, React, and PostgreSQL. Passionate about clean code and user experience.\",\n  \"template_id\": \"minimal\"\n}"
            },
            "url": "{{base_url}}/cv/profile/"
          }
        },
        {
          "name": "Patch Profile - Summary only (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"summary\": \"Updated summary with more than eighty characters to meet the completion scoring threshold for the summary section.\"\n}"
            },
            "url": "{{base_url}}/cv/profile/"
          }
        },
        {
          "name": "Get Completion (GET)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/cv/profile/completion/"
          }
        }
      ]
    },
