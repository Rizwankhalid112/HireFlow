              "mode": "raw",
              "raw": "{\n  \"name\": \"My Custom Tool\",\n  \"category\": \"Tools\",\n  \"proficiency\": \"intermediate\"\n}"
            },
            "url": "{{base_url}}/cv/skills/"
          }
        },
        {
          "name": "Bulk Add Skills (POST)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skills\": [\n    { \"canonical_id\": \"{{canonical_id}}\", \"proficiency\": \"advanced\" },\n    { \"name\": \"FastAPI\", \"category\": \"Frameworks\", \"proficiency\": \"advanced\" },\n    { \"name\": \"React\", \"category\": \"Frameworks\", \"proficiency\": \"advanced\" },\n    { \"name\": \"Docker\", \"category\": \"Tools\", \"proficiency\": \"intermediate\" },\n    { \"name\": \"Redis\", \"category\": \"Databases\", \"proficiency\": \"intermediate\" }\n  ]\n}"
